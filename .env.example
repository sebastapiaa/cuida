# ElevenLabs API key (used by `npm run sync:agent` to create/update the agent and its tools)
ELEVENLABS_API_KEY=
# Optional: a warm voice from the ElevenLabs voice library, and a fast LLM (e.g. gemini-2.5-flash)
ELEVENLABS_VOICE_ID=
AGENT_LLM=

# Filled in automatically by `npm run sync:agent`
PUBLIC_URL=
CUIDA_AGENT_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Daytona: analyze_lab_trend runs Python in a Daytona sandbox (falls back to "local" if unset)
DAYTONA_API_KEY=
DAYTONA_SANDBOX_ID=

# Optional: notify_family sends a real SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAMILY_PHONE=
