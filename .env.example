# Required: your ElevenLabs API key (used by scripts/setup-agent.mjs and to mint private WebRTC tokens)
ELEVENLABS_API_KEY=
# Filled in automatically by `npm run setup:agent`
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional: voice for the agent (pick a warm voice in the ElevenLabs voice library)
ELEVENLABS_VOICE_ID=

# Daytona: lab-trend analysis runs as Python in a Daytona sandbox (earns rubric points)
DAYTONA_API_KEY=
# Optional: reuse an existing sandbox instead of creating one on first request
DAYTONA_SANDBOX_ID=

# Optional: real SMS to "Ana" (use your own phone for the demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAMILY_PHONE=
